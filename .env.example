# Copy to .env (repo root) and adjust. Never commit .env.

# --- Claude (paid, pay-per-token on your Anthropic account) ---
# Get a key at https://console.anthropic.com/ -> API keys. Without it, JARVIS runs but can't reply.
ANTHROPIC_API_KEY=
# Default model (users can override it in Settings). Claude Sonnet 5.5 costs half as much.
# JARVIS_DEFAULT_MODEL=claude-opus-5-5
# Cap on each reply's length, in tokens.
# JARVIS_MAX_OUTPUT_TOKENS=16000
# Approximate cap on conversation history sent per message; oldest turns are dropped first.
# JARVIS_MAX_CONTEXT_TOKENS=150000
# JARVIS_REQUEST_TIMEOUT_SECONDS=300
# JARVIS_MAX_RETRIES=2
# Retry requests Claude's safety classifiers decline on Anthropic's recommended fallback model.
# JARVIS_REFUSAL_FALLBACK=true

# --- Server ---
# Keep 127.0.0.1 unless you deliberately expose JARVIS on your network.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Required for first-run account setup when JARVIS_HOST is not a loopback address.
# JARVIS_SETUP_TOKEN=choose-a-long-random-string
# JSON list of browser origins allowed to call the API.
# JARVIS_CORS_ORIGINS=["http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# --- Data ---
# Where the SQLite database and backups live (default: ./data).
# JARVIS_DATA_DIR=./data
# JARVIS_SESSION_TTL_HOURS=336
