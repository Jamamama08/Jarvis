# Copy to .env (repo root) and adjust. Never commit .env.

# --- Claude (paid, pay-per-token on your Anthropic account) ---
# Get a key at https://console.anthropic.com/ -> API keys. Without it, JARVIS runs but can't reply.
ANTHROPIC_API_KEY=
# Default model (users can override it in Settings). Claude Sonnet 5.5 costs half as much.
# JARVIS_DEFAULT_MODEL=claude-opus-5-5
# Cap on each reply's length, in tokens.
# JARVIS_MAX_OUTPUT_TOKENS=16000
# Approximate cap on conversation history sent per message; oldest turns are dropped first.
# JARVIS_MAX_CONTEXT_TOKENS=150000
# JARVIS_REQUEST_TIMEOUT_SECONDS=300
# JARVIS_MAX_RETRIES=2
# Retry requests Claude's safety classifiers decline on Anthropic's recommended fallback model.
# JARVIS_REFUSAL_FALLBACK=true

# --- Tools & agent loop ---
# Folder the file tools and Python runner can use (nothing outside it is reachable). Default: <data dir>/workspace
# JARVIS_WORKSPACE_DIR=./data/workspace
# Per message: max model requests, wall-clock limit, and token budget (input + output).
# JARVIS_MAX_TOOL_ITERATIONS=10
# JARVIS_TURN_TIMEOUT_SECONDS=600
# JARVIS_TURN_TOKEN_BUDGET=400000
# JARVIS_TOOL_TIMEOUT_SECONDS=30
# JARVIS_APPROVAL_TIMEOUT_SECONDS=300
# JARVIS_PYTHON_TOOL_ENABLED=true

# --- Autonomous tasks ---
# JARVIS_TASK_TOKEN_BUDGET=1000000
# JARVIS_TASK_TIMEOUT_SECONDS=1800
# JARVIS_TASK_APPROVAL_TIMEOUT_SECONDS=3600
# JARVIS_MAX_CONCURRENT_TASKS=2

# --- Browser automation & desktop control ---
# JARVIS_BROWSER_ENABLED=true
# Set false to watch JARVIS's browser window while it works.
# JARVIS_BROWSER_HEADLESS=true
# Allow pages on your private network (router, NAS, localhost). Off by default for safety.
# JARVIS_BROWSER_ALLOW_PRIVATE_NETWORK=false
# Desktop control is on only when JARVIS_HOST is loopback; force it on/off here.
# JARVIS_DESKTOP_CONTROL_ENABLED=

# --- Server ---
# Keep 127.0.0.1 unless you deliberately expose JARVIS on your network.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Required for first-run account setup when JARVIS_HOST is not a loopback address.
# JARVIS_SETUP_TOKEN=choose-a-long-random-string
# JSON list of browser origins allowed to call the API.
# JARVIS_CORS_ORIGINS=["http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# --- Data ---
# Where the SQLite database and backups live (default: ./data).
# JARVIS_DATA_DIR=./data
# JARVIS_SESSION_TTL_HOURS=336
# Automatic database backup every N hours (kept in <data dir>/backups). 0 turns it off.
# JARVIS_BACKUP_INTERVAL_HOURS=24

# --- Connections (all free) ---
# Email, calendar and phone-notification settings are entered in Settings -> Connections and
# stored server-side in <data dir>/secrets.json (owner-only file permissions), never in the
# database or the browser. The Claude API key can also be entered there instead of above;
# a key set in this file always wins. Weather uses Open-Meteo (free, no key).

