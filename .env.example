# Copy to .env (repo root) and adjust. Never commit .env.

# --- Claude (used from Phase 2; requires a paid Anthropic API account) ---
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_DEFAULT_MODEL=claude-sonnet-5-5
# JARVIS_MAX_OUTPUT_TOKENS=4096

# --- Server ---
# Keep 127.0.0.1 unless you deliberately expose JARVIS on your network.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Required for first-run account setup when JARVIS_HOST is not a loopback address.
# JARVIS_SETUP_TOKEN=choose-a-long-random-string
# JSON list of browser origins allowed to call the API.
# JARVIS_CORS_ORIGINS=["http://localhost:5173","tauri://localhost","http://tauri.localhost"]

# --- Data ---
# Where the SQLite database and backups live (default: ./data).
# JARVIS_DATA_DIR=./data
# JARVIS_SESSION_TTL_HOURS=336
